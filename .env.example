DATABASE_URL=sqlite:///./swiggy_mcp.db

# Step 2 (OAuth). Swiggy MCP supports Dynamic Client Registration, so leave
# SWIGGY_CLIENT_ID/SECRET unset -- the app self-registers a client on first
# login and caches it in the oauth_clients table. Only set these once Swiggy
# grants static production credentials (see mcp.swiggy.com/builders/docs).
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
SWIGGY_REDIRECT_URI=http://localhost:8000/auth/callback

# Step 5 (chat agent). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Auth hardening on /api/* (see app/session_auth.py). Without
# APP_PASSWORD_HASH set, login always fails closed -- /api/* stays 401 for
# everyone rather than falling open. Generate a hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
APP_PASSWORD_HASH=
# Signs the session cookie. If unset, a random one is generated per process
# start (safe -- just invalidates sessions on every restart). Set one for a
# real deployment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=
